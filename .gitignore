# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo
.tsdowncache/

# runtime SQLite (NOT committed; rebuildable from snapshots)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/*.db-sqlite

# workspace-scope runtime data (created at the repo root by dsh runs)
.dsh/

# NOTE: data/snapshots/*.md ARE committed — human-readable, versionable memory

# env / secrets
.env
.env.local
*.env

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# TRAE local artifacts
.trae/
.trae-html-share-packages/

# pnpm / corepack
.pnpm-debug.log*

# dev host: cloned deepseek-harness is NOT part of the yolo repo
host/

# logs
*.log
logs/

# test artifacts
coverage/
.vitest-cache/

# Playwright browser E2E artifacts (tests/e2e/*.spec.ts)
test-results/
playwright-report/
.playwright-cli/
output/

# dated local validation notes are evidence for the current workstation, not releases
docs/manual-validation-*.md
docs/test-report-*.md

# throwaway local UI-verification scaffolding (not part of the repo)
.tmp-e2e/

# throwaway local UI/UX review artifacts (internal analysis, not part of the repo)
docs/uiux-real-review.md
docs/uiux-review-*.png

# lockfile IS committed (registry deps) — CI installs with --frozen-lockfile

# tool-generated temp artifacts
.dsh-sdk-client-relcwd*/
vitest.config.ts.timestamp-*

# runtime-generated dev patch (contains absolute paths; created by scripts/dev.mjs)
cordis.dev.local.yml

# WorkBuddy workspace data (internal, not part of the plugin repo)
.workbuddy/
