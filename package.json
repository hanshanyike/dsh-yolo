{
  "name": "dsh-plugin-yolo",
  "version": "0.1.0",
  "description": "YOLO (You Only Live/Look Once) — personal ultimate intelligent assistant plugin for deepseek-harness. Extracts milestones/todos/goals/preferences from every session, stores them, proactively reminds, and renders a native dashboard.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client/index.js"
  },
  "dsh": {
    "bundle": "./cordis.bundle.yml",
    "client": "./client"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:./host/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-llm": "link:./host/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:./host/deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-tools": "link:./host/deepseek-harness/packages/core/tools",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
