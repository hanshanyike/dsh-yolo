{
  "name": "dsh-plugin-yolo",
  "version": "0.1.0",
  "description": "YOLO (You Only Live/Look Once) — personal ultimate intelligent assistant plugin for deepseek-harness. Extracts milestones/todos/goals/preferences from every session, stores them, proactively reminds, and renders a native dashboard.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/src/index.mjs",
  "exports": {
    ".": "./dist/src/index.mjs",
    "./client": "./dist/client/index.mjs",
    "./package.json": "./package.json",
    "./dist/src/storage": "./dist/src/storage/index.mjs",
    "./dist/src/memory": "./dist/src/memory/index.mjs",
    "./dist/src/extract": "./dist/src/extract/index.mjs",
    "./dist/src/reminder": "./dist/src/reminder/index.mjs",
    "./dist/src/ui": "./dist/src/ui/index.mjs"
  },
  "dsh": {
    "bundle": "./cordis.bundle.yml",
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.client.config.ts && node scripts/wrap-client.mjs && node scripts/copy-assets.mjs",
    "dev": "tsdown --watch",
    "dev:web": "node scripts/dev.mjs",
    "dev:web:setup": "node scripts/dev.mjs --setup",
    "dev:web:update": "node scripts/dev.mjs --update",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:./host/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-llm": "link:./host/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:./host/deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-tools": "link:./host/deepseek-harness/packages/core/tools",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^2.1.9",
    "react": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
